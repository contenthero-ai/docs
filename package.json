{
  "name": "contenthero-docs",
  "private": true,
  "type": "module",
  "description": "Source for docs.contenthero.ai. Tooling only: Mintlify renders the MDX, these scripts generate and guard the reference pages.",
  "scripts": {
    "generate:reference": "node scripts/generate-reference.mjs",
    "check:reference": "node scripts/generate-reference.mjs --check",
    "check:tool-names": "node scripts/check-tool-names.mjs",
    "check": "npm run check:currency && npm run check:reference && npm run check:skill-install && npm run check:tool-names && npm run check:spelling",
    "check:currency": "node scripts/check-package-currency.mjs",
    "generate:skill-install": "node scripts/generate-skill-install.mjs",
    "check:skill-install": "node scripts/generate-skill-install.mjs --check",
    "check:spelling": "check-american-spelling"
  },
  "devDependencies": {
    "@contenthero-ai/american-spelling": "0.1.2",
    "@contenthero-ai/connect": "0.1.3",
    "@contenthero/cli": "^0.3.10",
    "@contenthero/mcp": "^0.4.19",
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
